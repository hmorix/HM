# HMorix Platform Environment Variables

# Server
PORT=3001
NODE_ENV=development

# MySQL/MariaDB Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=hmorix
DB_POOL_SIZE=10

# Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=3600
REFRESH_TOKEN_SECRET=your_refresh_secret_here

# Storage (Cloudflare R2 or Google Drive)
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=hmorix-assets
# OR
GOOGLE_DRIVE_API_KEY=your_google_drive_key
GOOGLE_DRIVE_FOLDER_ID=your_folder_id

# Cloudflare D1 (Alternative to MySQL for edge)
D1_DATABASE_ID=your_d1_database_id
D1_API_TOKEN=your_d1_api_token

# Email (SendGrid)
SENDGRID_API_KEY=your_sendgrid_key
EMAIL_FROM=noreply@hmorix.com

# Analytics
ANALYTICS_ENABLED=true

# Redis (for caching & sessions)
REDIS_URL=redis://localhost:6379

# Frontend URL
CLIENT_URL=http://localhost:5173
